}
if (length(num_cols) == 0) {
stop("Aucune colonne numérique à renommer.")
}
if (length(num_cols) > 1) {
warning("Plusieurs colonnes numériques trouvées, seule la première est renommée en OBS_VALUE.")
}
df$OBS_VALUE <- df[[num_cols[1]]]
df[num_cols[1]] <- NULL
df
